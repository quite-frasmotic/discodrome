SUBSONIC_SERVER=""
SUBSONIC_USER=""
SUBSONIC_PASSWORD=""
SUBSONIC_AUTH_MODE="token"
DISCORD_BOT_TOKEN=""
DISCORD_TEST_GUILD=""
DISCORD_OWNER_ID=""
BOT_STATUS=""
BOT_PREFIX="?"
BOT_SEARCH_SUGGESTION_COUNT=5

# Soulseek / YouTube fallback for /play and /next when the library has no match (optional; needs the docker CLI and socket)
SLSK_USER=""
SLSK_PASS=""
SOCKSEEK_EXEC="docker exec -i sockseek"
SOCKSEEK_ARGS="--no-listen"
SLSK_CACHE_MAX_MB=500

# Loudness normalisation (EBU R128); NORMALIZE_AUDIO=0 turns it off
NORMALIZE_AUDIO=1
LOUDNORM_I=-16
LOUDNORM_TP=-1.5
LOUDNORM_LRA=11
